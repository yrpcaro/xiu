# Xiu starship prompt: two lines, accents from the pill palette, quiet when
# there is nothing to say. This is the template — wallcolors.py fills the
# __TOKENS__ with the current palette and writes starship.toml beside it on
# every wallpaper change, so the prompt follows the rest of the UI.

add_newline = true

format = """
$directory$git_branch$git_status$cmd_duration$line_break$character"""

[character]
success_symbol = "[❯](bold __CHAR_OK__)"
error_symbol = "[❯](bold __CHAR_ERR__)"

[directory]
style = "bold __DIR__"
truncation_length = 3
truncate_to_repo = true

[git_branch]
symbol = " "
style = "bold __BRANCH__"
format = "[$symbol$branch]($style) "

[git_status]
style = "__STATUS__"

[cmd_duration]
min_time = 2000
style = "__DURATION__"
format = "[$duration]($style) "

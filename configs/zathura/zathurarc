# Xiu zathura configuration
set font "JetBrainsMono Nerd Font 10"
set adjust-open "width"
set selection-clipboard "clipboard"
set window-title-basename "true"
set statusbar-home-tilde "true"

# Recolor and transparency settings (default washi RGBA values)
set recolor "true"
set recolor-keephue "true"
set recolor-reverse-video "false"

# Page background and text recolor
set recolor-lightcolor "rgba(33,23,17,0.85)"
set recolor-darkcolor "rgba(230,214,203,1.0)"

# Window background and foreground
set default-bg "rgba(33,23,17,0.85)"
set default-fg "rgba(230,214,203,1.0)"

# Statusbar
set statusbar-bg "rgba(33,23,17,0.85)"
set statusbar-fg "rgba(230,214,203,1.0)"

# Inputbar
set inputbar-bg "rgba(33,23,17,0.85)"
set inputbar-fg "rgba(230,214,203,1.0)"

# Notifications
set notification-bg "rgba(33,23,17,0.85)"
set notification-fg "rgba(230,214,203,1.0)"
set notification-error-bg "rgba(192,68,43,0.85)"
set notification-error-fg "rgba(255,246,240,1.0)"
set notification-warning-bg "rgba(216,154,91,0.85)"
set notification-warning-fg "rgba(255,246,240,1.0)"

# Highlight & Selection
set highlight-color "rgba(224,86,59,0.35)"
set highlight-active-color "rgba(224,86,59,0.65)"
set highlight-fg "rgba(230,214,203,1.0)"

# Completion
set completion-bg "rgba(33,23,17,0.85)"
set completion-fg "rgba(230,214,203,1.0)"
set completion-highlight-bg "rgba(224,86,59,1.0)"
set completion-highlight-fg "rgba(33,23,17,0.85)"
set completion-group-bg "rgba(37,26,19,0.85)"
set completion-group-fg "rgba(185,169,158,1.0)"

# Index mode (table of contents)
set index-bg "rgba(33,23,17,0.85)"
set index-fg "rgba(230,214,203,1.0)"
set index-active-bg "rgba(224,86,59,1.0)"
set index-active-fg "rgba(33,23,17,0.85)"

# Render loading
set render-loading "true"
set render-loading-bg "rgba(33,23,17,0.85)"
set render-loading-fg "rgba(185,169,158,1.0)"

# Signatures
set signature-error-color "rgba(192,68,43,1.0)"
set signature-warning-color "rgba(216,154,91,1.0)"
set signature-success-color "rgba(138,154,91,1.0)"

# Live dynamic theme generated from wallpaper by xiu
include theme
